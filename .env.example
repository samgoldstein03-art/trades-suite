# Demo records simulated messages only. Change to twilio when ready to send.
SMS_MODE=demo
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/suite.sqlite
UPLOAD_DIR=data/uploads
NUDGE_INTERVAL_MS=60000
# Required HTTPS origin when hosted. Render defaults to RENDER_EXTERNAL_URL.
# Leave blank for the private localhost app.
ADMIN_ORIGIN=
ADMIN_USERNAME=admin
# Required when hosted: a unique password of at least 16 characters.
# Leave blank ONLY for private localhost use.
ADMIN_PASSWORD=

# Required for signed inbound STOP/START webhooks. No trailing slash.
# Render defaults to RENDER_EXTERNAL_URL if this is blank.
# This endpoint stays public; the hosted admin pages require the password above.
PUBLIC_BASE_URL=https://your-webhook-host.example

# Match the SMS key entered in the business profile (example: HARBOR).
# Add a different group for every business. Never commit your .env file.
BUSINESS_HARBOR_ACCOUNT_SID=
BUSINESS_HARBOR_AUTH_TOKEN=
BUSINESS_HARBOR_PHONE_NUMBER=
